{
  "$schema": "https://cli.sasjs.io/sasjsconfig-schema.json",
  "macroFolders": [
    "sasjs/macros"
  ],
  "syncFolder": "sasjs/mocks",
  "programFolders": [],
  "serviceConfig": {
    "serviceFolders": [
      "sasjs/services/common",
      "sasjs/services/files"
    ],
    "initProgram": "sasjs/services/serviceinit.sas"
  },
  "defaultTarget": "viya",
  "targets": [
    {
      "name": "viya",
      "serverUrl": "",
      "serverType": "SASVIYA",
      "appLoc": "/Public/app/angular-seed-app",
      "contextName": "SAS Job Execution compute context",
      "sasjsBuildFolder": "sasjsbuild/viya"
    },
    {
      "name": "sas9",
      "serverUrl": "",
      "serverType": "SAS9",
      "appLoc": "/Public/app/angular-seed-app",
      "serverName": "SASApp",
      "repositoryName": "Foundation",
      "sasjsBuildFolder": "sasjsbuild/sas9"
    },
    {
      "name": "server",
      "serverUrl": "",
      "serverType": "SASJS",
      "appLoc": "/Public/app/angular-seed-app",
      "streamConfig": {
        "streamLogo": "assets/angular-logo.png",
        "streamServiceName": "Angular",
        "streamWeb": true,
        "streamWebFolder": "web",
        "webSourcePath": "dist/browser"
      },
      "sasjsBuildFolder": "sasjsbuild/server"
    },
    {
      "name": "mock",
      "serverUrl": "",
      "serverType": "SASJS",
      "appLoc": "/Public/app/angular-seed-app",
      "streamConfig": {
        "mockWeb": true,
        "mockWebFolder": "sasjsbuild/mock",
        "streamWeb": false,
        "webSourcePath": "dist/browser"
      }
    }
  ],
  "release": {
    "assets": [
      {
        "path": "sasjsbuild/server/server.json.zip",
        "label": "SASjs Streamed App (Zip File)"
      },
      {
        "path": "sasjsbuild/sas9/sas9.sas",
        "label": "SAS 9 EBI Deployment (SAS Program)"
      },
      {
        "path": "sasjsbuild/viya/viya.sas",
        "label": "Viya Deployment (SAS Program)"
      }
    ]
  }
}
