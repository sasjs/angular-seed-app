{
  "name": "@sasjs/angular-seed-app",
  "repository": "https://github.com/sasjs/angular-seed-app",
  "description": "Angular Seed App for SASjs",
  "version": "2.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 3000",
    "build": "ng build --configuration production && cpr docs dist/browser/docs",
    "build-dev": "ng build",
    "test": "ng test",
    "lint:fix": "npx prettier --write \"src/**/*.{ts,tsx,js,jsx,html,css,sass,less,json,yml,md,graphql}\"",
    "lint": "npx prettier --check \"src/**/*.{ts,tsx,js,jsx,html,css,sass,less,json,yml,md,graphql}\"",
    "audit": "node scripts/audit-check.js",
    "build-watch": "ng build --watch",
    "deploy": "rsync -avhe ssh ./dist/browser/* --delete $SSH_ACCOUNT:$DEPLOY_PATH",
    "sync": "./node_modules/.bin/watch --wait=3 \"echo Account: $SSH_ACCOUNT && npm run deploy && echo 'App is synced!'\" dist/browser",
    "check:data": "node scripts/springs-data.js --check",
    "mock:build": "npm run build && sasjs compile -t mock && sasjs build -t mock",
    "mock:start": "npx http-server ./sasjsbuild/mock -p 3001",
    "test:mock": "node scripts/check-mock-site.js"
  },
  "private": true,
  "keywords": [
    "sas",
    "SASjs",
    "viya",
    "sasjs_seed_app"
  ],
  "dependencies": {
    "@angular/animations": "^22.2.6",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@sasjs/adapter": "^6.1.0",
    "@sasjs/utils": "^4.11.0",
    "rxjs": "~7.5.5",
    "tslib": "^2.0.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/language-service": "^22.2.6",
    "@sasjs/cli": "^6.28.0",
    "@sasjs/core": "^7.1.14",
    "@semantic-release/changelog": "^6.0.1",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.11",
    "@types/node": "^20.1.2",
    "cpr": "^3.0.1",
    "istanbul-lib-instrument": "^6.0.3",
    "prettier": "^2.5.1",
    "semantic-release": "^25.0.9",
    "ts-node": "~10.8.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.0",
    "watch": "^0.13.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  }
}
